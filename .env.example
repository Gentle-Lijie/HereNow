NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-password
DB_NAME=herenow_dev
# Leave empty for direct connections. Only list actual sanitized proxy hops.
TRUSTED_PROXIES=
# Generate local secrets and administrator credentials with npm run setup.
TOKEN_SECRET=
IDENTITY_SECRET=
ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 高德 JS API Key 可在浏览器使用；安全密钥仅供后端代理，禁止添加 VITE_ 前缀。
VITE_AMAP_KEY=

AMAP_SECURITY_JS_CODE=
