[Unit]
Description=HereNow daily database backup
After=herenow-api.service

[Service]
Type=oneshot
User=herenow
Group=herenow
WorkingDirectory=/srv/herenow/current
Environment=PATH=/www/server/mysql/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/herenow/backend.env
ExecStart=/usr/local/bin/node --import tsx scripts/backup.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/herenow/shared
