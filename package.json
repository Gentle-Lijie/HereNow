{
  "name": "herenow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @herenow/api\" \"npm run dev -w @herenow/web\"",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "vue-tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc -p edge-functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build -w @herenow/web && npm run build -w @herenow/api",
    "build:frontend": "vue-tsc --noEmit -p apps/web/tsconfig.json && tsc -p edge-functions/tsconfig.json && npm run build -w @herenow/web",
    "start": "node apps/api/dist/apps/api/src/server.js",
    "cleanup": "tsx scripts/cleanup.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:deletions": "tsx scripts/restore-deletions.ts",
    "user:create": "tsx scripts/create-user.ts",
    "test:load": "DB_NAME=herenow_test NODE_ENV=test tsx scripts/load-test.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.js *.json",
    "format:check": "prettier --check apps packages scripts tests *.ts *.js *.json",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.6",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "ant-design-vue": "4.2.6",
    "csv-parse": "7.0.3",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "gcoord": "1.0.7",
    "jose": "6.2.12",
    "mysql2": "3.24.6",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "vant": "4.10.2",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
